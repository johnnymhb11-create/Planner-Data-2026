	measure 'Total de Promedio de DiasHabiles para Nombre del depósito' =
			
			CALCULATE(
				AVERAGE('Tareas'[DiasHabiles]),
				ALLSELECTED('Tareas'[Nombre del depósito])
			)
		formatString: 0
		lineageTag: 28e26583-556f-4927-9768-9db16453bfae

