	column 'Tiempo hoy' = ```
			
			IF(
			    ISBLANK(Tareas[Fecha de finalización]),"En Progreso",
			    VAR StartDate = Tareas[Fecha de creación]
			    VAR EndDate = Tareas[Fecha de finalización]
			    VAR TotalDays = DATEDIFF(StartDate, EndDate, DAY)
			    RETURN 
			        IF(
			            ISBLANK(StartDate) || ISBLANK(EndDate),
			            BLANK(),
			            VAR DateTable = 
			                ADDCOLUMNS(
			                    CALENDAR(StartDate, EndDate),
			                    "Weekday", WEEKDAY([Date], 2)
			                )
			            VAR WeekdaysCount = 
			                COUNTROWS(
			                    FILTER(
			                        DateTable,
			                        [Weekday] <= 5
			                    )
			                )
			            RETURN FORMAT(WeekdaysCount, "General Number")
			        )
			)
			```
		lineageTag: f8364e17-4939-427a-ba18-7f74d2f60abb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DiasHabiles = ```
			
			VAR FechaInicial = [Fecha de creación] 
			VAR FechaFinal = IF(ISBLANK(Tareas[Fecha de finalización]), TODAY(), Tareas[Fecha de finalización])
			VAR DiasTotales = DATEDIFF(FechaInicial, FechaFinal, DAY)
			VAR DiasHabiles = 
			    SUMX(
			        GENERATESERIES(0, DiasTotales),
			        VAR FechaActual = FechaInicial + [Value]
			        RETURN IF(WEEKDAY(FechaActual, 2) < 6, 1, 0)
			    )
			RETURN DiasHabiles
			
			```
		formatString: 0
		lineageTag: 965d3f3f-e858-4e67-a38f-c7c8aa8fc719
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Categoria de Tiempo' =
			
			IF(Tareas[DiasHabiles]<5,"Menos de 5 días",
			IF(Tareas[DiasHabiles]<10,"Entre 6 y 10 días",
			IF(Tareas[DiasHabiles]<15,"Entre 11 y 15 días",
			IF(Tareas[DiasHabiles]<20,"Entre 16 y 20 días",
			IF(Tareas[DiasHabiles]<25,"Entre 21 y 25 días",
			IF(Tareas[DiasHabiles]>=25,"Mayor de 25 días"))))))
		lineageTag: 2f5103f1-c928-4008-a97b-d9b9e678cd89
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Mes = MONTH(Tareas[Fecha de creación])
		formatString: 0
		lineageTag: 49106f23-498e-4290-9751-0abfbd9910d4
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Nombre del Mes' = ```
			
			SWITCH(
			    Tareas[Mes],
			    1, "Enero",
			    2, "Febrero",
			    3, "Marzo",
			    4, "Abril",
			    5, "Mayo",
			    6, "Junio",
			    7, "Julio",
			    8, "Agosto",
			    9, "Septiembre",
			    10, "Octubre",
			    11, "Noviembre",
			    12, "Diciembre",
			    "Mes Desconocido"  // Valor por defecto si el número no está entre 1 y 12
			)
			
			```
		lineageTag: 790acef8-c62f-4628-9ef1-2d44a34136db
		summarizeBy: none
		sortByColumn: Mes

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column NumCatg = ```
			
			IF(Tareas[Categoria de Tiempo] = "Menos de 5 días", 1, 
			IF(Tareas[Categoria de Tiempo] = "Entre 6 y 10 días", 2, 
			IF(Tareas[Categoria de Tiempo] = "Entre 11 y 15 días", 3, 
			IF(Tareas[Categoria de Tiempo] = "Entre 16 y 20 días", 4,
			IF(Tareas[Categoria de Tiempo] = "Entre 21 y 25 días", 5,
			IF(Tareas[Categoria de Tiempo] = "Mayor de 25 días",6))))))
			```
		formatString: 0
		lineageTag: 6da399c9-3f00-4391-a092-17c1998992ca
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column NumBucket =
			IF
			(Tareas[Nombre del depósito] = "Cuentas por Pagar",1,
			IF(Tareas[Nombre del depósito] = "Asignación de Diarios de Pagos", 2,
			IF(Tareas[Nombre del depósito] = "Diarios de Pago",3,
			IF(Tareas[Nombre del depósito] = "Presupuesto",4,
			IF(Tareas[Nombre del depósito] = "Presupuesto - En Espera de Respuesta",5)))))
		formatString: 0
		lineageTag: 670da416-901a-4703-8e7d-c0d714ddfbd1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

